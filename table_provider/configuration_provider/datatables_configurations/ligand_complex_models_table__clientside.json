{
  "serverSide": false,
  "processing": true,
  "deferRender": true,
  "scrollX": true,
  "layout": {
    "topEnd": "pageLength",
    "topStart": "buttons"
  },
  "ajax": {
    "url": "/table_provider/ligand_complex_models_table_cached",
    "type": "GET",
    "cache": false,
    "dataSrc":  "data"
  },
  "search": {
    "regex": true,
    "caseInsensitive": true
  },
  "order": [[2, "asc"]],
  "nullValuePlaceholder": "-",
  "lengthMenu": [25, 50, 100, 250, 500],
  "buttons": [ "clear_selection_default", "clear_filters_default", "column_visibility", "excel_default"],
  "fixedWidthTable": true
}
